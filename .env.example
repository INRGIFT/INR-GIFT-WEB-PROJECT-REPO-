# Copy to .env.local. Everything is optional: with no values the app runs on demo data with a demo account.
# Never commit real values. Only NEXT_PUBLIC_* values reach the browser, and only browser-safe keys may use that prefix.

# ---- Market data -------------------------------------------------------------
# "demo" (default), "nse" (NSE source adapter, src/providers/nse) or "real" (generic vendor stub). See docs/PROVIDERS.md.
# NSE credentials are not listed: their names depend on the NSE product INRGIFT licenses (docs/CONNECTORS.md).
MARKET_DATA_PROVIDER=demo
# Optional secondary provider when the primary fails ("demo" | "nse" | "real" | empty).
# A "demo" fallback marks the whole site as demo data and keeps it out of search engines.
MARKET_DATA_FALLBACK=

# ---- Supabase (auth + private workspace) ----------------------------------------
# Leave empty to run with the built-in demo account (browser-local data).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…), browser-safe; access is governed by row-level security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative to the publishable key. Used only when the publishable key is empty.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Test builds only: "demo" forces the built-in demo account even when Supabase values are present. Never in production.
NEXT_PUBLIC_AUTH_MODE=

# ---- Stock and ETF logos ----------------------------------------------------------
# "logo.dev" or "none" (ticker tiles only).
NEXT_PUBLIC_LOGO_PROVIDER=none
# Logo.dev publishable key (pk_…). Browser-safe by Logo.dev's design; restrict it to your domain in the Logo.dev
# dashboard. Never put the Logo.dev secret key (sk_…) here or anywhere in this app.
NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY=

# ---- Internal ------------------------------------------------------------------------
# Shared secret required by POST /api/internal/ingest (header: x-ingest-secret). Server-only.
INGEST_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Search engines -------------------------------------------------------------------
# Demo data is never indexable. With a live provider the site is indexable unless this is "false";
# set "true" only to force indexing (for example a staging site with licensed data).
SITE_INDEXABLE=

# Email goes through Resend via the Supabase Send Email Hook (see below and docs/CONNECTORS.md).

# ---- Server-only provider secrets (never NEXT_PUBLIC_, never committed, never in the GoDaddy zip) --------------------
# Supabase secret key (sb_secret_…) or legacy service-role key: records verified phones and SMS step-ups. Route handlers only.
SUPABASE_SECRET_KEY=
# Supabase → Authentication → Hooks → Send Email secret ("v1,whsec_…"); the hook URL is https://<domain>/api/hooks/send-email
SEND_EMAIL_HOOK_SECRET=
# Resend: transactional email (confirmation, reset, security notices)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# 2Factor.in: SMS codes for phone verification and the second factor at sign-in
TWO_FACTOR_API_KEY=
TWO_FACTOR_OTP_TEMPLATE=
# NewsData.io ("News IO"): business and market news. Empty = demo headlines.
NEWSIO_API_KEY=
NEWSIO_PAGE_SIZE=10
NEWSIO_CACHE_SECONDS=900
