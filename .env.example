# ---- Market data provider -------------------------------------------------
# "demo" (default) or "real". See docs/PROVIDERS.md.
MARKET_DATA_PROVIDER=demo
# Optional secondary provider used when the primary fails ("demo" | "real" | empty).
MARKET_DATA_FALLBACK=
# Server-only credentials for a real provider. Never prefix these with NEXT_PUBLIC_.
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=

# ---- Supabase ---------------------------------------------------------------
# Leave both empty to run with the built-in demo account (browser-local data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used only by /api/internal/* ingestion routes. Never import in client code.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Internal -----------------------------------------------------------------
# Shared secret required by /api/internal/ingest (header: x-ingest-secret).
INGEST_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
