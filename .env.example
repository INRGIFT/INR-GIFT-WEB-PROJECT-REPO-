# Copy to .env.local. Everything is optional: with no values the app runs on demo data with a demo account.
# Never commit real values. Only NEXT_PUBLIC_* values reach the browser, and only browser-safe keys may use that prefix.

# ---- Market data -------------------------------------------------------------
# "demo" (default), "nse" (NSE source adapter, src/providers/nse) or "real" (generic vendor stub). See docs/PROVIDERS.md.
# NSE credentials are not listed: their names depend on the NSE product INRGIFT licenses (docs/CONNECTORS.md).
MARKET_DATA_PROVIDER=demo
# Optional secondary provider when the primary fails ("demo" | "nse" | "real" | empty).
# A "demo" fallback marks the whole site as demo data and keeps it out of search engines.
MARKET_DATA_FALLBACK=
# Homepage market values (hero chart, market strip, screen and compare previews) with a licensed provider. Server-only.
# "on" only after confirming the data licence allows public, signed-out display. Empty: the homepage shows sessions and
# structure but no prices. Ignored with the demo provider, whose simulated values are always shown labelled DEMO.
PUBLIC_MARKET_DATA=

# ---- Supabase (auth + private workspace) ----------------------------------------
# Leave empty to run with the built-in demo account (browser-local data).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…), browser-safe; access is governed by row-level security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative to the publishable key. Used only when the publishable key is empty.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Test builds only: "demo" forces the built-in demo account even when Supabase values are present. Never in production.
NEXT_PUBLIC_AUTH_MODE=

# ---- Stock and ETF logos ----------------------------------------------------------
# "logo.dev" or "none" (ticker tiles only).
NEXT_PUBLIC_LOGO_PROVIDER=none
# Logo.dev publishable key (pk_…). Browser-safe by Logo.dev's design; restrict it to your domain in the Logo.dev
# dashboard. Never put the Logo.dev secret key (sk_…) here or anywhere in this app.
NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY=

# ---- Internal ------------------------------------------------------------------------
# Shared secret required by POST /api/internal/ingest (header: x-ingest-secret). Server-only.
INGEST_SECRET=

# ---- Site URL -----------------------------------------------------------------------
# Canonical URLs, sitemap, email links and production redirects. Production: https://inrgift.com (no trailing slash).
# Empty: http://localhost:3000 in development, https://inrgift.com in a production build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Search engines -------------------------------------------------------------------
# Demo data is never indexable. With a live provider the site is indexable unless this is "false";
# set "true" only to force indexing (for example a staging site with licensed data).
SITE_INDEXABLE=

# Email goes through Resend via the Supabase Send Email Hook (see below and docs/CONNECTORS.md).

# ---- Server-only provider secrets (never NEXT_PUBLIC_, never committed, never in the GoDaddy zip) --------------------
# Supabase secret key (sb_secret_…) or legacy service-role key: records verified phones and SMS step-ups. Route handlers only.
SUPABASE_SECRET_KEY=
# Supabase → Authentication → Hooks → Send Email secret ("v1,whsec_…"); the hook URL is https://<domain>/api/hooks/send-email
SEND_EMAIL_HOOK_SECRET=
# Resend: transactional email (confirmation, reset, security notices)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# 2Factor.in: SMS codes for phone verification and the second factor at sign-in
TWO_FACTOR_API_KEY=
TWO_FACTOR_OTP_TEMPLATE=
# SMS second factor switch. Leave empty (off) until 2Factor.in DLT approval, the two keys above and migration 0007 are
# all in place; then set "on" and rebuild (docs/AUTH-SECURITY.md, "Switching SMS on"). Browser-visible, not a secret.
NEXT_PUBLIC_SMS_SECOND_FACTOR=
# Lifetime of the six-digit email verification code in seconds (default 120 = 2 minutes). Must equal Supabase →
# Authentication → Sign In / Providers → Email → Email OTP Expiration, which is what actually enforces it. Shown in the
# email, the countdown and the "expired" message. Browser-safe: no secret.
NEXT_PUBLIC_EMAIL_OTP_SECONDS=

# ---- Company, support and Google -------------------------------------------------------------------------------------
# Support phone shown on Support, footer and legal pages ONLY when set (never invented). Example format: +91 98765 43210
SUPPORT_PHONE=
# Inbox for support, grievance and account-closure forms (default support@inrgift.com). Server-only.
SUPPORT_INBOX_EMAIL=
# "off" treats Google / Apple sign-in as unavailable here (the button stays and says so). Otherwise each follows its
# provider switch in Supabase (Authentication → Providers).
GOOGLE_SIGN_IN=
APPLE_SIGN_IN=
# YYYY-MM-DD when the legal documents were last revised (default: the date in src/services/content/legal.ts).
LEGAL_LAST_UPDATED=
# NewsData.io ("News IO"): business and market news. Empty = demo headlines.
NEWSIO_API_KEY=
NEWSIO_PAGE_SIZE=10
NEWSIO_CACHE_SECONDS=900
# "Latest from INRGIFT" on the homepage (server-only; official APIs; src/services/social). Empty = follow cards only.
# Instagram API with Instagram Login: long-lived token of the @inrgift professional account (renew within 60 days).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# X API v2 app-only Bearer token (plan must include reading a user's posts); X_USER_ID optional (looked up by username).
X_BEARER_TOKEN=
X_USER_ID=
SOCIAL_CACHE_SECONDS=1800
